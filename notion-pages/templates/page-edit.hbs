<section class="np-edit">
  {{#if imported}}
  <p class="hint">Page importée du wiki : titre, texte et rangement seront remis à jour au prochain import. Les mots-clés restent.</p>
  {{/if}}
  <div class="form-group">
    <label for="{{rootId}}-link">Lien publié</label>
    <div class="form-fields">
      <input type="url" id="{{rootId}}-link" name="link" value="{{link}}" placeholder="https://monsite.notion.site/Ma-page-0123456789abcdef0123456789abcdef">
    </div>
    <p class="hint">Le lien de la page publiée sur le web (Partager → Publier). Une page non publiée ne s'affichera pas.</p>
  </div>
  <div class="form-group">
    <label for="{{rootId}}-keywords">Mots-clés</label>
    <div class="form-fields">
      <input type="text" id="{{rootId}}-keywords" name="system.keywords" value="{{keywords}}" placeholder="taverne, Vogua, PNJ…">
    </div>
    <p class="hint">Aident la recherche de la bibliothèque (en plus du titre et du texte importé).</p>
  </div>
  <div class="form-group">
    <label for="{{rootId}}-icon">Icône</label>
    <div class="form-fields">
      <input type="text" id="{{rootId}}-icon" name="system.icon" value="{{icon}}" placeholder="🏰" maxlength="8">
    </div>
  </div>
</section>
